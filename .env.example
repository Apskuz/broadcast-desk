# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard → Project Settings → API)

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Push notifications — generate with `npx web-push generate-vapid-keys`.
# VITE_VAPID_PUBLIC_KEY must also be set (identically) in Vercel, since it's
# read at build time. VAPID_PRIVATE_KEY stays server-only.
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Google Drive upload — from a Google Cloud service account with Drive API
# enabled and access to the destination folder (see README for steps).
GDRIVE_CLIENT_EMAIL=
GDRIVE_PRIVATE_KEY=
GDRIVE_FOLDER_ID=
